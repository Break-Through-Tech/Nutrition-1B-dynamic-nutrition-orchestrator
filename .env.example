# Copy this file to .env and fill in your own key:
#
#     cp .env.example .env          # bash
#     Copy-Item .env.example .env   # PowerShell
#
# Get a free key instantly at https://fdc.nal.usda.gov/api-key-signup
# A personal key allows 1,000 requests/hour (DEMO_KEY allows only 30).
#
# .env is git-ignored. Never commit your real key.

USDA_API_KEY=your_key_here
